{
  "name": "sybauargon-desktop",
  "version": "1.0.0",
  "description": "sybauargon - ứng dụng nhắn tin cho máy tính",
  "main": "main.js",
  "author": "sybauargon",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "site.je.sybauargon",
    "productName": "sybauargon",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "picker.html", "picker-preload.js", "offline.html", "config.json", "assets/**/*", "package.json"],
    "win": { "artifactName": "sybauargon-setup.exe", "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "mac": { "target": "dmg", "category": "public.app-category.social-networking", "icon": "build/icon.png" },
    "linux": { "target": ["AppImage"], "category": "Network", "icon": "build/icon.png" }
  }
}
